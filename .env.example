# Copy to ~/fin-portfolio-demo/fin-backend/.env on the server. Never commit the real file.

POSTGRES_PASSWORD=

# Must be exactly 32 chars (AES-256 key) / 16 chars (IV). Reuses the same
# values as your local appsettings.Development.json if you want existing
# encrypted emails to keep decrypting.
ApiSettings__Authentication__Encrypt__Key=
ApiSettings__Authentication__Encrypt__Iv=

# Any long random string; only needs to be stable across deploys.
ApiSettings__Authentication__Jwt__Key=
ApiSettings__Authentication__Jwt__Issuer=appfin.com
ApiSettings__Authentication__Jwt__Audience=appfin.com

# Public URL the visitor's browser will load the frontend from. Also used
# for the API's CORS policy - must match exactly (scheme + host, no slash).
ApiSettings__FrontendConfigs__Url=https://localhost:4200

# Public URL the visitor's browser will call the API on. Passed as a Docker
# build-arg (PUBLIC_API_URL) so it gets baked into the frontend bundle.
PUBLIC_API_URL=https://localhost:7122/v1

# Host ports published on this VM, for a reverse proxy running on another
# machine (e.g. NPM on a different Oracle VM) to reach over the private
# network - point it at <this VM's private IP>:<port>, not localhost.
FIN_API_PORT=8091
FIN_FRONT_PORT=8090
